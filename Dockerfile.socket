# Multi-stage production Dockerfile for Socket Microservice
FROM node:20-alpine AS builder

RUN apk add --no-cache openssl libc6-compat

WORKDIR /app

# Copy package files and prisma schema
COPY socket-server/package*.json ./
COPY prisma ./prisma/

# Install all dependencies (including devDependencies like typescript, prisma, and tsx for building)
RUN npm install --ignore-scripts --legacy-peer-deps

# Generate Prisma Client
RUN npx prisma generate --schema=./prisma/schema.prisma

# Copy source code and tsconfig
COPY socket-server/server.ts ./
COPY socket-server/tsconfig.json ./

# Build TypeScript to Javascript
RUN npm run build

# Production Runner Stage
FROM node:20-alpine AS runner

RUN apk add --no-cache openssl libc6-compat

WORKDIR /app

# Copy package files and prisma schema
COPY socket-server/package*.json ./
COPY prisma ./prisma/

# Install production dependencies only
RUN npm install --only=production --ignore-scripts --legacy-peer-deps

# Copy compiled build output and generated prisma clients
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client

EXPOSE 3002

CMD ["node", "dist/server.js"]
