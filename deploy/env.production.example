# TaskFlow production environment for deploy/docker-compose.prod.yml
# Copy this file to deploy/.env and replace every placeholder.
# This file is intentionally separate from the local development .env.

# --- Public address ---------------------------------------------------------
# For a free no-account hostname, use http://<public-ip>.sslip.io in the browser
# and put <public-ip>.sslip.io here (without https://).
# For a nicer name, create a free DuckDNS record and use it instead.
DOMAIN=change-me.sslip.io

# --- PostgreSQL -------------------------------------------------------------
# Use a URL-safe password (hex is safest): openssl rand -hex 24
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=taskflow

# --- Application secrets ----------------------------------------------------
# Generate each with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
JWT_SECRET=replace-with-openssl-rand-hex-32

# --- Billing ----------------------------------------------------------------
# true = built-in test gateway, moves no money. Use false only with live keys.
BILLING_ALLOW_TEST_PAYMENTS=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# --- OAuth (optional) -------------------------------------------------------
# Redirect URIs:
#   https://<DOMAIN>/api/auth/callback/google
#   https://<DOMAIN>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Uploads ----------------------------------------------------------------
# The app stores uploads on the VM volume by default.
# UploadThing is not required when using the local upload route.
UPLOADTHING_TOKEN=

# --- Optional external services --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
